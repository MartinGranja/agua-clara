GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=30
DATABASE_URL=sqlite:///./data/aguaclara.db
# El panel del dueño funciona en loopback sin token. Para acceso remoto,
# configurar ADMIN_TOKEN y un reverse proxy HTTPS; no usar este servidor expuesto.
ADMIN_TOKEN=
ALLOW_REMOTE=false

# Aviso automático al dueño cuando un cliente confirma la consulta. Todos opcionales.
# WhatsApp propio vía CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/):
OWNER_WHATSAPP_PHONE=
CALLMEBOT_API_KEY=
# Telegram (bot de @BotFather + id del chat):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook genérico (n8n, Make, Zapier...): recibe un POST JSON con "text" y "request".
NOTIFY_WEBHOOK_URL=

# Visión híbrida: cuántas lecturas independientes de Gemini por foto (1 a 3). Con 1 se gasta menos cuota.
VISION_SAMPLES=2
CV_ENABLED=true
